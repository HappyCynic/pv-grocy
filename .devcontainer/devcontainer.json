{
  "name": "Private Grocy MCP (pv-grocy)",
  // Compose so each machine can add its own mounts in compose.local.yaml (gitignored)
  // without editing committed files; see compose.local.example.yaml.
  "dockerComposeFile": ["compose.yaml", "compose.local.yaml"],
  "service": "dev",
  "runServices": ["dev", "grocy"],
  "workspaceFolder": "/workspaces/pv-grocy",
  "shutdownAction": "stopCompose",
  "remoteUser": "vscode",

  "features": {
    // Build/run the production image against the host's Docker daemon.
    // moby packages don't exist for Debian trixie; use Docker's upstream CLI.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": { "moby": false },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // claude-code and the OpenSpec CLI need node+npm; without this the claude-code
    // feature falls back to Debian's nodejs package, which ships no npm, and fails.
    "ghcr.io/devcontainers/features/node:2": { "version": "lts" },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },

  // Runs on the host: creates the gitignored local files (Grocy key, compose override,
  // config) from their templates so the container never references a missing file.
  "initializeCommand": "sh .devcontainer/initialize.sh",

  "forwardPorts": [8772, "grocy:80"],
  "portsAttributes": {
    "8772": { "label": "pv-grocy MCP", "onAutoForward": "silent" },
    "grocy:80": { "label": "Demo Grocy", "onAutoForward": "silent" }
  },

  "postCreateCommand": "bash .devcontainer/post-create.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-containers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/home/vscode/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
