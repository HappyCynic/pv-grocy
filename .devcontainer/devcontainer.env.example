# Copy to devcontainer.env (gitignored; done automatically on first start) and fill in.
# Only needed to run against a real Grocy: the tests use a fake, and the demo Grocy
# (http://grocy:80) accepts any key. Never commit real values.
#
#   PV_GROCY_API_KEY   Grocy API key (Grocy: Manage API keys); use a test instance
#   PV_GROCY_WRITE     `enabled` to allow tokens with write or full access
# MCP bearer tokens are not stored here: config holds their SHA-256 hashes,
# and the plaintext token lives only with the client.

PV_GROCY_API_KEY=demo
# PV_GROCY_WRITE=enabled
